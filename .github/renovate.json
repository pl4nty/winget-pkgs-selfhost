{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["github>pl4nty/.github"],
	"packageRules": [
		{
			"matchUpdateTypes": ["patch", "minor", "digest"],
			"automerge": true
		},
		{
			"matchManagers": "github-actions",
			"minimumReleaseAge": "7 days"
		},
		{
			"matchManagers": "mise",
			"minimumReleaseAge": "3 days"
		},
		{
			"matchPackageNames": ["jdx/mise"],
			"minimumReleaseAge": "3 days"
		},
		{
			"matchPackageNames": ["oxlint", "oxfmt"],
			"groupName": "oxc ecosystem"
		},
		{
			"description": "Shared actions from our own repository, which commits too often to ever reach a minimum release age",
			"matchManagers": ["github-actions"],
			"matchPackageNames": ["pl4nty/winget-extras{,/**}"],
			"minimumReleaseAge": null,
			"groupName": "winget-extras actions"
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"],
			"depNameTemplate": "mise",
			"packageNameTemplate": "jdx/mise",
			"datasourceTemplate": "github-releases",
			"versioningTemplate": "semver",
			"extractVersionTemplate": "^v(?<version>.*)$",
			"matchStrings": [
				"uses:\\s+jdx/mise-action@[^\\s#]+(?:\\s+#[^\\r\\n]*)?\\r?\\n\\s+with:\\r?\\n\\s+version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
			]
		}
	]
}
